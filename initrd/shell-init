#!/bin/busybox sh
# Minimal Quest 1 RAM-only rescue shell, adapted from initrd/init.
# No block filesystem is mounted and no system-image handover is provided.
/bin/busybox --install -s /bin
export PATH=/bin TERM=linux
export PS1='quest-shell:\w # '
mkdir -p /proc /sys /dev /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=755 tmpfs /run
mount -t configfs configfs /sys/kernel/config
exec >/dev/kmsg 2>&1
log() { echo "quest-shell: $*"; }
hostname quest-shell
log "starting RAM-only shell; persistent filesystems remain unmounted"

G=/sys/kernel/config/usb_gadget/g1
mkdir -p "$G"
cd "$G" || { log "configfs unavailable"; exec sh </dev/console >/dev/console 2>&1; }
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo 0x0200 > bcdUSB
echo 0xEF > bDeviceClass
echo 0x02 > bDeviceSubClass
echo 0x01 > bDeviceProtocol
mkdir -p strings/0x409 configs/c.1/strings/0x409
echo quest1-shell > strings/0x409/serialnumber
echo Quest1 > strings/0x409/manufacturer
echo 'Quest 1 RAM shell' > strings/0x409/product
echo 'NCM network and serial shell' > configs/c.1/strings/0x409/configuration
echo 500 > configs/c.1/MaxPower
# Give the serial shell its own function so it survives a network setup failure.
if mkdir -p functions/acm.GS0; then
    ln -s functions/acm.GS0 configs/c.1/ || log "serial link failed"
fi
if mkdir -p functions/ncm.usb0; then
    echo 02:51:01:00:00:01 > functions/ncm.usb0/dev_addr
    echo 02:51:01:00:00:02 > functions/ncm.usb0/host_addr
    ln -s functions/ncm.usb0 configs/c.1/ || log "network link failed"
fi
for attempt in $(seq 1 30); do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] && break
    sleep 1
done
if [ -n "$UDC" ]; then
    echo "$UDC" > UDC && log "USB gadget bound to $UDC" || log "USB bind failed"
else
    log "no USB device controller found"
fi
cd /
(
    while :; do
        if [ -c /dev/ttyGS0 ]; then
            setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
        fi
        sleep 1
    done
) &
ifconfig lo 127.0.0.1 up
for attempt in $(seq 1 30); do
    [ -e /sys/class/net/usb0 ] && break
    sleep 1
done
if ifconfig usb0 192.168.77.1 netmask 255.255.255.0 up; then
    cat > /run/udhcpd.conf <<'EOF'
start 192.168.77.2
end 192.168.77.2
interface usb0
lease_file /run/udhcpd.leases
option subnet 255.255.255.0
EOF
    touch /run/udhcpd.leases
    udhcpd /run/udhcpd.conf || log "DHCP failed; set host address to 192.168.77.2/24 manually"
    telnetd -l /bin/sh -b 192.168.77.1 || log "telnet failed; use USB serial"
    if [ -x /bin/dropbearmulti ] && [ -f /root/.ssh/authorized_keys ]; then
        # Key-only SSH as root; the host key is generated in RAM on first connection.
        [ -f /etc/passwd ] || echo 'root:x:0:0:root:/root:/bin/sh' > /etc/passwd
        [ -f /etc/group ] || echo 'root:x:0:' > /etc/group
        mkdir -p /etc/dropbear
        /bin/dropbearmulti dropbear -R -s -E -p 192.168.77.1:22 || log "ssh failed; use telnet"
    fi
    log "ready: telnet 192.168.77.1, or USB serial; reboot -f returns to normal boot"
else
    log "USB network unavailable; use USB serial"
fi
while :; do sleep 3600; done
