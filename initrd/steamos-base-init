#!/bin/busybox sh
# Quest 1 SteamOS base boot with a USB rescue shell.
# Mounts userdata and a prepared holo.img only after read-only validation.
/bin/busybox --install -s /bin
export PATH=/bin TERM=linux
export PS1='quest-steamos:\w # '
mkdir -p /proc /sys /dev /run /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=755 tmpfs /run
mount -t configfs configfs /sys/kernel/config
exec >/dev/kmsg 2>&1
log() { echo "quest-steamos: $*"; }
hostname quest-steamos
log "starting SteamOS base boot; checking optional rootfs after USB debug setup"

G=/sys/kernel/config/usb_gadget/g1
mkdir -p "$G"
cd "$G" || { log "configfs unavailable"; exec sh </dev/console >/dev/console 2>&1; }
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo 0x0200 > bcdUSB
echo 0xEF > bDeviceClass
echo 0x02 > bDeviceSubClass
echo 0x01 > bDeviceProtocol
mkdir -p strings/0x409 configs/c.1/strings/0x409
echo quest1-shell > strings/0x409/serialnumber
echo Quest1 > strings/0x409/manufacturer
echo 'Quest 1 SteamOS base' > strings/0x409/product
echo 'NCM network and serial shell' > configs/c.1/strings/0x409/configuration
echo 500 > configs/c.1/MaxPower
# Give the serial shell its own function so it survives a network setup failure.
if mkdir -p functions/acm.GS0; then
    ln -s functions/acm.GS0 configs/c.1/ || log "serial link failed"
fi
if mkdir -p functions/ncm.usb0; then
    echo 02:51:01:00:00:01 > functions/ncm.usb0/dev_addr
    echo 02:51:01:00:00:02 > functions/ncm.usb0/host_addr
    ln -s functions/ncm.usb0 configs/c.1/ || log "network link failed"
fi
for attempt in $(seq 1 30); do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] && break
    sleep 1
done
if [ -n "$UDC" ]; then
    echo "$UDC" > UDC && log "USB gadget bound to $UDC" || log "USB bind failed"
else
    log "no USB device controller found"
fi
cd /
(
    while :; do
        if [ -c /dev/ttyGS0 ]; then
            setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
        fi
        sleep 1
    done
) &
ifconfig lo 127.0.0.1 up
for attempt in $(seq 1 30); do
    [ -e /sys/class/net/usb0 ] && break
    sleep 1
done
if ifconfig usb0 192.168.77.1 netmask 255.255.255.0 up; then
    cat > /run/udhcpd.conf <<'EOF'
start 192.168.77.2
end 192.168.77.2
interface usb0
lease_file /run/udhcpd.leases
option subnet 255.255.255.0
EOF
    touch /run/udhcpd.leases
    udhcpd /run/udhcpd.conf || log "DHCP failed; set host address to 192.168.77.2/24 manually"
    telnetd -l /bin/sh -b 192.168.77.1 || log "telnet failed; use USB serial"
    log "ready: telnet 192.168.77.1, or USB serial; checking for prepared Holo rootfs next"
else
    log "USB network unavailable; use USB serial"
fi

# The source slot was verified as B after returning from the minimal shell.
# Never start this prepared image from the downgraded inactive slot.
SLOT=
for arg in $(cat /proc/cmdline); do
 case "$arg" in androidboot.slot_suffix=*) SLOT=${arg#*=};; esac
done
handover_failed() {
 log "Holo handover failed after writable mounts; use the serial rescue shell to inspect and unmount before reboot"
 while :; do
  TTY=/dev/ttyGS0
  [ -c "$TTY" ] || TTY=/newroot/dev/ttyGS0
  setsid sh -c 'exec sh -i <"$1" >"$1" 2>&1' sh "$TTY"
  sleep 1
 done
}
boot_holo() {
 [ "$SLOT" = _b ] || { log "Expected Android slot _b, found '$SLOT'; staying in rescue shell"; return; }
 mkdir -p /data /newroot
 UD=
 for event in /sys/class/block/sd*/uevent; do
  if grep -q '^PARTNAME=userdata$' "$event"; then
   [ -z "$UD" ] || { log "Multiple userdata partitions; refusing"; return; }
   name=${event%/uevent}; UD=/dev/${name##*/}
  fi
 done
 [ -b "$UD" ] || { log "userdata partition missing"; return; }
 # With no installed image, this boot only inspects userdata without journal replay.
 mount -t ext4 -o ro,noload "$UD" /data || { log "userdata read-only mount failed"; return; }
 if [ ! -f /data/steamos/holo.img ]; then
  log "No /data/steamos/holo.img; leaving userdata unmounted, rescue shell ready"
  umount /data; return
 fi
 LOOP=$(losetup -f) || { umount /data; return; }
 if ! losetup -r "$LOOP" /data/steamos/holo.img || ! mount -t ext4 -o ro,noload "$LOOP" /newroot; then
  log "Holo image mount failed"; losetup -d "$LOOP"; umount /data; return
 fi
 if [ ! -f /newroot/etc/quest1-base-release ] || [ ! -x /newroot/usr/lib/systemd/systemd ]; then
  log "Not the prepared Holo base image; refusing switch_root"
  umount /newroot; losetup -d "$LOOP"; umount /data; return
 fi
 umount /newroot || return
 losetup -d "$LOOP" || return
 umount /data || return
 mount -t ext4 -o rw,noatime "$UD" /data || return
 if ! losetup "$LOOP" /data/steamos/holo.img || ! mount -t ext4 -o rw,noatime "$LOOP" /newroot; then
  log "Validated image could not be reopened read-write"
  losetup -d "$LOOP"; umount /data; return
 fi
 mkdir -p /newroot/userdata || handover_failed
 mount --move /data /newroot/userdata || handover_failed
 log "Switching to Holo; USB telnet and serial remain available. Use systemctl reboot for a clean return."
 # No user-space firmware helper: a request made before quest1-modem sets the firmware path (/run/fw)
 # would wait 60 s for one (Venus on the first open of its video node). Fail such requests after 2 s.
 echo 2 > /sys/class/firmware/timeout
 kill -9 -1
 sleep 0.2
 umount /dev/pts || handover_failed
 mount --move /dev /newroot/dev || handover_failed
 mount --move /run /newroot/run || handover_failed
 mount --move /proc /newroot/proc || handover_failed
 mount --move /sys /newroot/sys || handover_failed
 H=/newroot/run/holo-init
 mkdir -p "$H" || handover_failed
 cp /bin/busybox "$H/" || handover_failed
 ln -sf busybox "$H/sh" || handover_failed
 # Keep one USB-only rescue telnet daemon, and the DHCP server that hands the host 192.168.77.2:
 # networkd's own DHCP server needs socket features kernel 4.4 lacks ("Protocol not available").
 chroot /newroot /run/holo-init/busybox telnetd -l /run/holo-init/sh -b 192.168.77.1
 chroot /newroot /run/holo-init/busybox udhcpd /run/udhcpd.conf
 exec switch_root /newroot /usr/lib/systemd/systemd --log-target=kmsg --log-level=info
}
boot_holo
log "Rescue shell ready; no SteamOS filesystem is active"
while :; do sleep 3600; done

